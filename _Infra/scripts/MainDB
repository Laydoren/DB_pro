DROP TABLE batches;
DROP TABLE users;
DROP TABLE parameters;
DROP TABLE positions;
DROP TABLE equipment_types;


-- Типы оборудования
CREATE TABLE equipment_types (
    id INTEGER NOT NULL PRIMARY KEY,
    name VARCHAR NOT NULL UNIQUE
);

-- Должности
CREATE TABLE positions (
    id INTEGER NOT NULL PRIMARY KEY,
    name VARCHAR NOT NULL UNIQUE
);

-- Пользователи
CREATE TABLE users (
    id INTEGER NOT NULL PRIMARY KEY,
    login VARCHAR NOT NULL UNIQUE,
    full_name VARCHAR NOT NULL,
    position_id INTEGER NOT NULL REFERENCES positions (id)
);

-- Параметры
CREATE TABLE parameters (
    id INTEGER NOT NULL PRIMARY KEY,
    name VARCHAR NOT NULL UNIQUE,
    min_value DECIMAL,  
    max_value  DECIMAL,
    default_value DECIMAL NOT NULL,
    is_integer BOOLEAN NOT NULL
);

-- Пачки (логи?)
CREATE TABLE batches (
    id INTEGER NOT NULL PRIMARY KEY,
    batch_number INTEGER NOT NULL,
    user_id INTEGER NOT NULL REFERENCES users (id),
    equipment_type_id INTEGER NOT NULL REFERENCES equipment_types (id),
    parameter_id INTEGER NOT NULL REFERENCES parameters (id),
    param_value DECIMAL NOT NULL,
    time_at INTEGER NOT NULL
);


