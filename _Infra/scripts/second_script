--Изменяем таблицу
ALTER TABLE parameters ADD COLUMN parameter_type_id INTEGER;
ALTER TABLE parameters ADD COLUMN value DECIMAL;
ALTER TABLE parameters ADD COLUMN batch_id INTEGER;

ALTER TABLE parameters DROP COLUMN name;
ALTER TABLE parameters DROP COLUMN min_value;
ALTER TABLE parameters DROP COLUMN max_value;
ALTER TABLE parameters DROP COLUMN default_value;


INSERT INTO parameters (id, parameter_type_id, value, batch_id)
    SELECT b.id, b.parameter_id, b.param_value, b.batch_number
    FROM batches AS b;


--Убираем дупликаты в логах
DELETE FROM batches
    WHERE id NOT IN (SELECT MIN(id) FROM batches GROUP BY batch_number);

ALTER TABLE batches DROP COLUMN parameter_id;
ALTER TABLE batches DROP COLUMN param_value;
ALTER TABLE batches DROP COLUMN batch_number;



SELECT
    b.time_at AS time_at,
    b.id AS batch_number,
    u.full_name AS user_full_name,
    pt.name || ', ' || bu.name AS parameter_and_unit,
    p.value AS value
FROM parameters AS p, batches AS b, users AS u, parameter_types AS pt, base_units AS bu
WHERE b.id  = p.batch_id
    AND u.id  = b.user_id
    AND pt.id = p.parameter_type_id
    AND bu.parameter_type_id = pt.id


