--Создание структуры
BEGIN;

--Типы оборудования
CREATE TABLE equipment_types (
	id INTEGER NOT NULL PRIMARY KEY,
	name VARCHAR (20) NOT NULL UNIQUE
);

CREATE SEQUENCE public.seq_equipment_types;
ALTER TABLE public.equipment_types
	ALTER COLUMN id SET DEFAULT nextval('public.seq_equipment_types');


--Должности
CREATE TABLE positions (
	id INTEGER NOT NULL PRIMARY KEY,
	name VARCHAR (100) NOT NULL UNIQUE
);

CREATE SEQUENCE public.seq_positions;
ALTER TABLE public.positions
	ALTER COLUMN id SET DEFAULT nextval('public.seq_positions');


--Пользователи
CREATE TABLE users (
	id INTEGER NOT NULL PRIMARY KEY,
	login VARCHAR (20) NOT NULL UNIQUE,
	full_name VARCHAR (100) NOT NULL,
	position_id INTEGER NOT NULL
);

CREATE SEQUENCE public.seq_users;
ALTER TABLE public.users
	ALTER COLUMN id SET DEFAULT nextval('public.seq_users');


--Типы параметров
CREATE TABLE parameter_types (
	id INTEGER NOT NULL PRIMARY KEY,
	name VARCHAR (50) NOT NULL UNIQUE,
	min_value DECIMAL,
	max_value DECIMAL,
	default_value DECIMAL NOT NULL
);

CREATE SEQUENCE public.seq_parameter_types;
ALTER TABLE public.parameter_types
	ALTER COLUMN id SET DEFAULT nextval('public.seq_parameter_types');


--Базовые ед. измер.
CREATE TABLE base_units (
	id INTEGER NOT NULL PRIMARY KEY,
	name VARCHAR (20) NOT NULL,
	parameter_type_id INTEGER NOT NULL
);

CREATE SEQUENCE public.seq_base_units;
ALTER TABLE public.base_units
	ALTER COLUMN id SET DEFAULT nextval('public.seq_base_units');


--Ед. измер.
CREATE TABLE units (
	id INTEGER NOT NULL PRIMARY KEY,
	name VARCHAR (20) NOT NULL,
	conversion DECIMAL NOT NULL,
	base_unit_id INTEGER NOT NULL
);

CREATE SEQUENCE public.seq_units;
ALTER TABLE public.units
	ALTER COLUMN id SET DEFAULT nextval('public.seq_units');


--Пачки
CREATE TABLE batches (
	id INTEGER NOT NULL PRIMARY KEY,
	user_id INTEGER NOT NULL,
	equipment_type_id INTEGER NOT NULL,
	time_at INTEGER NOT NULL
);

CREATE SEQUENCE public.seq_batches;
ALTER TABLE public.batches
	ALTER COLUMN id SET DEFAULT nextval('public.seq_batches');


--Параметры
CREATE TABLE parameters (
	id INTEGER NOT NULL PRIMARY KEY,
	parameter_type_id INTEGER NOT NULL,
	value DECIMAL NOT NULL,
	batch_id INTEGER NOT NULL
);

CREATE SEQUENCE public.seq_parameters;
ALTER TABLE public.parameters
	ALTER COLUMN id SET DEFAULT nextval('public.seq_parameters');

COMMIT;


