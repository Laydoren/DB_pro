--связи
BEGIN;

ALTER TABLE users
    ADD CONSTRAINT fk_users_position
    FOREIGN KEY (position_id) REFERENCES positions (id);

ALTER TABLE base_units
    ADD CONSTRAINT fk_base_units_parameter_type
    FOREIGN KEY (parameter_type_id) REFERENCES parameter_types (id);

ALTER TABLE units
    ADD CONSTRAINT fk_units_base_unit
    FOREIGN KEY (base_unit_id) REFERENCES base_units (id);

ALTER TABLE batches
    ADD CONSTRAINT fk_batches_user
    FOREIGN KEY (user_id) REFERENCES users (id);

ALTER TABLE batches
    ADD CONSTRAINT fk_batches_equipment_type
    FOREIGN KEY (equipment_type_id) REFERENCES equipment_types (id);

ALTER TABLE parameters
    ADD CONSTRAINT fk_parameters_parameter_type
    FOREIGN KEY (parameter_type_id) REFERENCES parameter_types (id);

ALTER TABLE parameters
    ADD CONSTRAINT fk_parameters_batch
    FOREIGN KEY (batch_id) REFERENCES batches (id);

COMMIT;


BEGIN;
 
CREATE TABLE temp_calc (
	id INTEGER NOT NULL PRIMARY KEY,
	name VARCHAR (20) NOT NULL UNIQUE,
	virtual_correction DECIMAL NOT NULL
);
 
CREATE SEQUENCE public.seq_temp_calc;
ALTER TABLE public.temp_calc
	ALTER COLUMN id SET DEFAULT nextval('public.seq_temp_calc');
 
--t0 (°C) → ΔT_V (поправка)
INSERT INTO temp_calc (name, virtual_correction) VALUES
