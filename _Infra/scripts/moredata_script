SELECT
    b.time_at AS time_at,
    b.id AS batch_number,
    u.full_name AS user_full_name,
    pt.name || ', ' || bu.name AS parameter_and_unit,
    p.value AS value
FROM parameters AS p, batches AS b, users AS u, parameter_types AS pt, base_units AS bu
WHERE b.id  = p.batch_id
    AND u.id  = b.user_id
    AND pt.id = p.parameter_type_id
    AND bu.parameter_type_id = pt.id

